# ═══════════════════════════════════════════════════════════════════════════════
# StudyBuddyBot — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
#
# ⚠️  NEVER commit your `.env` file to version control.
#     `.env` is already listed in `.gitignore`.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Telegram ─────────────────────────────────────────────────────────────────
# Your bot's HTTP API token, obtained from @BotFather on Telegram.
# Example: 1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set to "ollama" for local model (default) or "openai" / "anthropic" for cloud.
LLM_PROVIDER=ollama

# Ollama host (only needed if running Ollama separately, not via docker-compose).
# When using docker-compose, this is automatically set to the ollama service.
OLLAMA_HOST=http://ollama:11434

# Ollama model to use. Options: llama3:8b (powerful), gemma:2b (fast/small).
OLLAMA_MODEL=llama3:8b

# ── Cloud LLM (Optional — only if LLM_PROVIDER is not "ollama") ───────────────
# OpenAI API key (leave blank if using Ollama)
OPENAI_API_KEY=

# Anthropic API key (leave blank if using Ollama)
ANTHROPIC_API_KEY=

# ── OpenClaw Gateway ──────────────────────────────────────────────────────────
# Log level: "debug", "info", "warn", "error"
LOG_LEVEL=info

# Node environment
NODE_ENV=production
