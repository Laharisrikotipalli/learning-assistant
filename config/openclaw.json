{
  "agent": {
    "name": "StudyBuddyBot",
    "description": "A personalized daily tech brief and interview preparation assistant delivered through Telegram."
  },

  "gateway": {
    "mode": "local"
  },

  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true,
        "package": "@openclaw/plugin-telegram",
        "config": {
          "botToken": "${env.TELEGRAM_BOT_TOKEN}"
        }
      },

      "ollama": {
        "enabled": true
      }
    }
  },

  "llm": {
    "provider": "ollama",
    "model": "llama3.2:3b",

    "options": {
      "temperature": 0.7,
      "num_ctx": 4096
    }
  },

  "tools": {
    "web_search": {
      "enabled": true,
      "provider": "duckduckgo"
    },

    "memory_store": {
      "enabled": true,
      "persistPath": "/data/memory"
    }
  },

  "skills": {
    "directory": "/app/skills"
  },

  "cron": {
    "jobs": [
      {
        "name": "nightly-tech-brief",
        "schedule": "0 21 * * *",
        "timezone": "Asia/Kolkata",
        "prompt": "Run the daily-quiz skill for the user."
      }
    ]
  }
}